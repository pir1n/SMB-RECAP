def version_output_name(path, index, total_versions):
    if not path:
        path = "unknown"
    if total_versions <= 1:
        return path
    return f"{path}@{index}"


def export_files(file_table, tree):
    files = []

    for f in file_table.files.values():
        versions = []
        deduped_versions = f.versions.deduplicated_versions()

        for index, v in enumerate(deduped_versions):
            versions.append({
                "version": index,
                "name": version_output_name(f.path, index, len(deduped_versions)),
                "size": v.size,
                "op": v.last_op,
                "modified": v.modified,
                "chunks": v.chunks
            })

        files.append({
            "file_id": f.file_id,
            "path": f.path,
            "metadata": {
                "created": f.metadata.created,
                "modified": f.metadata.modified,
                "accessed": f.metadata.accessed,
                "size": f.metadata.size,
            },
            "versions": versions
        })

    return {
        "files": files,
        "tree": tree
    }
