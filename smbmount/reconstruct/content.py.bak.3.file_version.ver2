from smbmount.core.file_table import FileTable


def process_packets(packets):
    table = FileTable()
    last_write_version = {}  # filename -> (file_obj, version_index)


    for pkt in packets:
        cmd = pkt.get("smb2_command_name")
        file_id = pkt.get("smb2_file_id")
        last_write = pkt.get("smb2_last_write_time")
        is_response = pkt.get("smb2_is_response")
        
        if not file_id:
            continue

        file_obj = table.get_or_create(file_id)

        # metadata always update
        file_obj.update_metadata(pkt)

        # CREATE → path
        if cmd == "CREATE":
            filename = pkt.get("smb2_filename")
            if filename:
                file_obj.path = filename
            if is_response is True:
                path = file_obj.path
                if path and last_write and path in last_write_version:
                    prev_file_obj, prev_version_idx = last_write_version[path]
                    prev_versions = prev_file_obj.versions.versions
                    if prev_version_idx < len(prev_versions):
                        prev_v = prev_versions[prev_version_idx]
                        if prev_v.last_op == "write" and prev_v.modified != last_write:
                            prev_v.modified = last_write
                            prev_v.snapshot_metadata = {
                                "created": prev_file_obj.metadata.created,
                                "modified": last_write,
                                "accessed": pkt.get("smb2_last_access_time"),
                                "size": prev_v.size,
                            }
                    del last_write_version[path]
                file_obj.open(last_write)
            continue

        if cmd in ("SET_INFO", "QUERY_INFO"):
            file_obj.update_version_metadata(last_write)
            continue

        if cmd == "READ" and is_response is True:
            offset = pkt.get("smb2_offset")
            length = pkt.get("smb2_length")
            if offset is not None and length is not None:
                file_obj.add_read(offset, length, last_write)
                # Snapshot metadata tại thời điểm READ
                if file_obj.versions.current:
                    file_obj.versions.current.snapshot_metadata = {
                        "created": file_obj.metadata.created,
                        "modified": pkt.get("smb2_last_write_time"),
                        "accessed": pkt.get("smb2_last_access_time"),
                        "size": file_obj.metadata.size,
                    }
            continue

        if cmd == "WRITE" and is_response is True:
            offset = pkt.get("smb2_offset")
            length = pkt.get("smb2_length")
            if offset is not None and length is not None:
                file_obj.add_write(offset, length, last_write)
                if file_obj.versions.current:
                    file_obj.versions.current.snapshot_metadata = {
                        "created": file_obj.metadata.created,
                        "modified": pkt.get("smb2_last_write_time"),
                        "accessed": pkt.get("smb2_last_access_time"),
                        "size": file_obj.metadata.size,
                    }
                    # Lưu lại version WRITE mới nhất
                    filename = file_obj.path
                    if filename:
                        last_write_version[filename] = (
                            file_obj,
                            len(file_obj.versions.versions) - 1
                        )
            continue
                
        # if cmd == "QUERY_INFO":
        #     info_type = pkt.get("smb2_query_info_type")
        #     file_class = pkt.get("smb2_query_file_class")
        #     response_data = pkt.get("smb2_query_info_response_data")
        #     print(pkt)

        if cmd == "CLOSE" and is_response is True:
            status = pkt.get("smb2_status")
            filename = file_obj.path
            if status == "0":
                if filename and last_write and filename in last_write_version:
                    prev_file_obj, prev_version_idx = last_write_version[filename]
                    prev_versions = prev_file_obj.versions.versions
                    if prev_version_idx < len(prev_versions):
                        prev_v = prev_versions[prev_version_idx]
                        if prev_v.last_op == "write":
                            prev_v.modified = last_write
                            prev_v.snapshot_metadata = {
                                "created": prev_file_obj.metadata.created,
                                "modified": last_write,
                                "accessed": pkt.get("smb2_last_access_time") or last_write,
                                "size": prev_v.size,
                            }
                    del last_write_version[filename]
            file_obj.commit(last_write)
            
    return table
