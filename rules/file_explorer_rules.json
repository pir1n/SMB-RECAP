{
  "application": "windows_file_explorer",
  "format": "smbmount-semantic-scf-v2",
  "source": "Derived only from Dev_Train_rule_file_explorer.pcapng and its ground truth; frozen before hold-out evaluation",
  "rules": [
    {
      "id": "explorer_create_directory",
      "action": "creation of directory",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x00100081", "create_disposition": "0x00000002", "create_options": "0x00200021", "create_result": "created", "target_type": "directory"}},
        {"command": "SET_INFO", "features": {"file_info_class": "FileRenameInformation", "rename_target_present": true}}
      ],
      "max_gap": 64,
      "same_file_id": false,
      "allow_different_file_ids": true,
      "allow_cross_transport": true,
      "require_success": true,
      "require_path": true,
      "confidence": 0.96
    },
    {
      "id": "explorer_create_file",
      "action": "creation of file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x0016019f", "create_disposition": "0x00000002", "create_options": "0x00000064", "create_result": "created", "target_type": "file"}},
        {"command": "SET_INFO", "features": {"file_info_class": "FileRenameInformation", "rename_target_present": true}}
      ],
      "max_gap": 64,
      "same_file_id": false,
      "allow_different_file_ids": true,
      "allow_cross_transport": true,
      "require_success": true,
      "require_path": true,
      "confidence": 0.96
    },
    {
      "id": "explorer_copy_within_share",
      "action": "upload file",
      "description": "Destination-side representation of an Explorer copy within the share",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x0017019f", "create_disposition": "0x00000002", "create_options": "0x00000044", "create_result": "created", "target_type": "file"}},
        {"command": "SET_INFO", "features": {"file_info_class": "FileRenameInformation", "rename_target_present": true}}
      ],
      "max_gap": 96,
      "same_file_id": false,
      "allow_different_file_ids": true,
      "allow_cross_transport": true,
      "require_success": true,
      "require_path": true,
      "confidence": 0.92
    },
    {
      "id": "explorer_upload_file",
      "action": "upload file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x0017019f", "create_disposition": "0x00000002", "create_options": "0x00000044", "create_result": "created", "target_type": "file"}},
        {"command": "SET_INFO", "features": {"file_info_class": "FileAllocationInformation"}},
        {"command": "WRITE", "features": {"length_class": "nonzero"}}
      ],
      "max_gap": 16,
      "require_success": true,
      "require_path": true,
      "confidence": 0.97
    },
    {
      "id": "explorer_copy_destination_created",
      "action": "upload file",
      "description": "Destination-side behavior for an Explorer copy within the SMB share",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x0017019f", "create_disposition": "0x00000002", "create_options": "0x00000044", "create_result": "created", "target_type": "file"}}
      ],
      "require_success": true,
      "require_path": true,
      "confidence": 0.89
    },
    {
      "id": "explorer_download_file",
      "action": "download file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x00120089", "create_disposition": "0x00000001", "create_options": "0x00200044", "create_result": "opened", "target_type": "file"}},
        {"command": "READ", "features": {"length_class": "nonzero"}}
      ],
      "max_gap": 16,
      "require_success": true,
      "require_path": true,
      "confidence": 0.96
    },
    {
      "id": "explorer_open_file",
      "action": "read of file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x00120089", "create_disposition": "0x00000001", "create_options": "0x00000060", "create_result": "opened", "target_type": "file"}},
        {"command": "READ", "features": {"length_class": "nonzero"}}
      ],
      "max_gap": 12,
      "require_success": true,
      "require_path": true,
      "confidence": 0.88
    },
    {
      "id": "explorer_edit_file",
      "action": "write to file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x0012019f", "create_disposition": "0x00000003", "create_options": "0x00000060", "create_result": "opened", "target_type": "file"}},
        {"command": "WRITE", "features": {"length_class": "nonzero"}}
      ],
      "max_gap": 32,
      "require_success": true,
      "require_path": true,
      "confidence": 0.94
    },
    {
      "id": "explorer_delete_file",
      "action": "deletion of file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x00010080", "create_disposition": "0x00000001", "create_options": "0x00001040", "create_result": "opened", "target_type": "file", "delete_on_close": true}}
      ],
      "require_success": true,
      "require_path": true,
      "confidence": 0.98
    },
    {
      "id": "explorer_rename_move",
      "action": "rename or move of file",
      "pattern": [
        {"command": "CREATE", "features": {"access_mask": "0x00110080", "create_disposition": "0x00000001", "create_options": "0x00200020", "create_result": "opened"}},
        {"command": "SET_INFO", "features": {"file_info_class": "FileRenameInformation", "rename_target_present": true}}
      ],
      "max_gap": 16,
      "require_success": true,
      "require_path": true,
      "confidence": 0.94
    },
    {
      "id": "explorer_directory_listing",
      "action": "directory listing",
      "pattern": [
        {"command": "CREATE", "contains": {"access_intents": ["read", "metadata"]}},
        {"command": "QUERY_DIRECTORY", "features": {"file_info_class": "FileIdBothDirectoryInformation"}}
      ],
      "max_gap": 24,
      "require_success": true,
      "require_path": true,
      "confidence": 0.86
    }
  ]
}
