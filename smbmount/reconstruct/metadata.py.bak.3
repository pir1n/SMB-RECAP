from typing import Dict
class FileMetadata:
    def __init__(self):
        self.created = None
        self.modified = None
        self.accessed = None
        self.size = 0
        
    def update_from_packet(self, pkt: Dict):
                
        self.created = pkt.get("smb2_create_time")
        self.modified = pkt.get("smb2_last_write_time")
        self.accessed = pkt.get("smb2_last_access_time")
            
        length = pkt.get("smb2_length")
        offset = pkt.get("smb2_offset")
        
        if length is not None and offset is not None:
            self.size = max(self.size, offset + length)
        